---
import RootLayout from "@/src/layouts/RootLayout.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer";
import SovereignBar from "@/components/SovereignBar";
import { Home, Compass, MapPin, Phone, MessageSquare, ArrowRight, ShieldCheck, Sparkles } from "lucide-react";

const title = "404 - Page Not Found | Kumar Magnacity Township Hadapsar";
const description = "The requested page could not be located. Explore Kumar Magnacity 2 BHK & 3 BHK luxury residences, NA villa plots, and master layout at Hadapsar Annexe, Manjari Pune.";
const canonical = "https://kumarmagnacitytownship.com/404";
---

<RootLayout title={title} description={description} canonical={canonical}>
  <Header client:load />

  <main class="min-h-[85vh] bg-warm-bg text-primary flex items-center justify-center py-20 px-4 relative overflow-hidden">
    {/* Subtle Background Glow */}
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,rgba(212,154,31,0.08),transparent_65%)] pointer-events-none" aria-hidden="true"></div>

    <div class="container mx-auto max-w-4xl relative z-10 text-center space-y-10">
      
      {/* 404 Badge & Monogram */}
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent/10 border border-accent/30 text-accent font-sans font-bold text-xs uppercase tracking-widest shadow-sm">
        <Sparkles size={14} className="text-accent" />
        <span>Navigation Guidance</span>
      </div>

      <div class="space-y-4">
        <h1 class="text-7xl md:text-9xl font-heading font-black text-primary tracking-tight">
          404
        </h1>
        <h2 class="text-2xl md:text-4xl font-heading font-bold text-primary max-w-2xl mx-auto">
          The Sanctuary You Seek is Located Elsewhere
        </h2>
        <p class="text-stone-600 text-sm md:text-base max-w-xl mx-auto font-light leading-relaxed">
          The requested address may have moved or is under active refinement. Let us guide you back to the master-planned ecosystem of Kumar Magnacity.
        </p>
      </div>

      {/* Quick Access Matrix */}
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-left max-w-3xl mx-auto">
        <a 
          href="/kumar-magnacity-2bhk-flats-hadapsar-pune-price" 
          class="p-5 rounded-2xl bg-white border border-stone-200/80 shadow-sm hover:border-accent hover:shadow-lg transition-all group"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-accent">2 BHK Residences</span>
            <ArrowRight size={14} class="text-stone-400 group-hover:text-accent group-hover:translate-x-1 transition-all" />
          </div>
          <p class="text-xs text-stone-500">757 sq.ft Smart Luxury from ₹72.99L*</p>
        </a>

        <a 
          href="/kumar-magnacity-3bhk-apartments-manjari-pune-price" 
          class="p-5 rounded-2xl bg-white border border-stone-200/80 shadow-sm hover:border-accent hover:shadow-lg transition-all group"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-accent">3 BHK Grand Suites</span>
            <ArrowRight size={14} class="text-stone-400 group-hover:text-accent group-hover:translate-x-1 transition-all" />
          </div>
          <p class="text-xs text-stone-500">1,053 sq.ft Suites from ₹1.05Cr*</p>
        </a>

        <a 
          href="/kumar-magnacity-price" 
          class="p-5 rounded-2xl bg-white border border-stone-200/80 shadow-sm hover:border-accent hover:shadow-lg transition-all group"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-accent">Sovereign Plots</span>
            <ArrowRight size={14} class="text-stone-400 group-hover:text-accent group-hover:translate-x-1 transition-all" />
          </div>
          <p class="text-xs text-stone-500">NA Villa Plots with 7/12 Extract</p>
        </a>

        <a 
          href="/kumar-magnacity-location-advantages-hadapsar-manjari" 
          class="p-5 rounded-2xl bg-white border border-stone-200/80 shadow-sm hover:border-accent hover:shadow-lg transition-all group"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-accent">Location & School</span>
            <ArrowRight size={14} class="text-stone-400 group-hover:text-accent group-hover:translate-x-1 transition-all" />
          </div>
          <p class="text-xs text-stone-500">Podar School on campus & IT proximity</p>
        </a>

        <a 
          href="/kumar-magnacity-floor-plan-2bhk-3bhk" 
          class="p-5 rounded-2xl bg-white border border-stone-200/80 shadow-sm hover:border-accent hover:shadow-lg transition-all group"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-accent">Floor Plans</span>
            <ArrowRight size={14} class="text-stone-400 group-hover:text-accent group-hover:translate-x-1 transition-all" />
          </div>
          <p class="text-xs text-stone-500">Vastu-compliant architectural layouts</p>
        </a>

        <a 
          href="/" 
          class="p-5 rounded-2xl bg-white border border-stone-200/80 shadow-sm hover:border-accent hover:shadow-lg transition-all group"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-accent">Township Home</span>
            <Home size={14} class="text-stone-400 group-hover:text-accent group-hover:scale-110 transition-all" />
          </div>
          <p class="text-xs text-stone-500">Return to official master showcase</p>
        </a>
      </div>

      {/* Primary Actions */}
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a 
          href="/" 
          class="btn-gold py-3 px-8 rounded-full text-xs uppercase tracking-wider font-bold inline-flex items-center gap-2 shadow-lg"
        >
          <Compass size={16} />
          <span>Explore Master Showcase</span>
        </a>
        <a 
          href="tel:+917744009295" 
          class="py-3 px-6 rounded-full bg-white border border-stone-300 text-primary text-xs uppercase tracking-wider font-bold inline-flex items-center gap-2 hover:bg-stone-50 transition-all shadow-sm"
        >
          <Phone size={14} class="text-accent" />
          <span>Contact Sales Desk</span>
        </a>
      </div>

    </div>
  </main>

  <Footer client:idle />
  <SovereignBar client:idle />
</RootLayout>
