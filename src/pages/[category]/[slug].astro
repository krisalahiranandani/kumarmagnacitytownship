---
import RootLayout from "@/src/layouts/RootLayout.astro";
import SEONodePage, { generateMetadata } from "@/app/[category]/[slug]/page";
import registry from "@/data/seo-registry.json";

export async function getStaticPaths() {
  const enKeys = Object.keys(registry).filter(k => !k.startsWith("mr/") && k.split("/").length === 2);
  return enKeys.map((key) => {
    const [category, slug] = key.split("/");
    return {
      params: { category, slug }
    };
  });
}

const { category, slug } = Astro.params;
const meta = await generateMetadata({ params: Promise.resolve({ category: category!, slug: slug! }) });
const title = (meta?.title as string) || "Kumar Magnacity Real Estate";
const description = (meta?.description as string) || "Explore Kumar Magnacity Hadapsar Annexe, Manjari Pune.";
const canonical = `https://kumarmagnacitytownship.com/${category}/${slug}`;
---

<RootLayout title={title} description={description} canonical={canonical}>
  <SEONodePage params={Promise.resolve({ category: category!, slug: slug! })} client:load />
</RootLayout>
