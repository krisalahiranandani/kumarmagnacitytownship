---
import RootLayout from "@/src/layouts/RootLayout.astro";
import MarathiSEONodePage from "@/app/mr/[category]/[slug]/page";
import registry from "@/data/seo-registry.json";

const pageKey = "mr/market-insights-kumar-magnacity-na-bungalow-plots";
const data = (registry as any)[pageKey] || {};
const title = data.title || "मार्केट इनसाइट्स | कुमार मॅग्नासिटी";
const description = data.description || "कुमार मॅग्नासिटी मार्केट इनसाइट्स आणि विश्लेषण.";
const canonical = "https://kumarmagnacitytownship.com/mr/market-insights-kumar-magnacity-na-bungalow-plots";
---

<RootLayout title={title} description={description} canonical={canonical}>
  <MarathiSEONodePage params={Promise.resolve({ category: "market-insights-kumar-magnacity-na-bungalow-plots", slug: "" })} client:load />
</RootLayout>
